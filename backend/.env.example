# Copy to .env in this folder (backend/) for local Development only.
# Never commit .env — real credentials belong in user secrets or Azure App Settings.

ASPNETCORE_ENVIRONMENT=Development

# Required in Production (use user secrets locally):
# SystemIdentity__AdminPassword=CHANGE_ME_STRONG_PASSWORD

LiveTrading__Enabled=false

# Broker (m.Stock) — optional for local dev if using Broker panel OTP login
Broker__ApiKey=YOUR_API_KEY
Broker__ApiSecret=YOUR_API_SECRET
Broker__ClientCode=YOUR_CLIENT_ID
Broker__TotpSecret=
Broker__RedirectUrl=
Broker__RestBaseUrl=https://api.mstock.trade
Broker__WsUrl=wss://ws.mstock.trade

# Legacy section still supported:
# MStock__ApiKey=
# MStock__Username=
# MStock__Password=

# SQLite (default). Use absolute or relative path under backend/data if desired.
ConnectionStrings__DefaultConnection=Data Source=trade-history.db

# Or:
# Database__SqlitePath=trade-history.db
# TradeHistory__DatabasePath=trade-history.db

# Future PostgreSQL:
# Database__Provider=PostgreSQL
# ConnectionStrings__DefaultConnection=Host=...;Database=...;Username=...;Password=...

Cors__AllowedOrigins__0=https://localhost:45212
Cors__AllowedOrigins__1=http://localhost:45212

AllowedHosts=*

# Security (reserved / future use)
Security__JwtSigningKey=
Security__DataEncryptionKey=
