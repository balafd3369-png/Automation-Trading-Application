{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "SystemIdentity": {
    "RequireAuthentication": true,
    "AllowAnonymousLocalUser": false,
    "RegistrationMode": "Open"
  },
  "LiveTrading": {
    "Enabled": false
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "Infrastructure": {
    "SignalREnableDetailedErrors": false
  },
  "Security": {
    "CookieSecure": true
  }
}
