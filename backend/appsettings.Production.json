{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SystemIdentity": {
    "RequireAuthentication": true,
    "AllowAnonymousLocalUser": false,
    "RegistrationMode": "Open"
  },
  "LiveTrading": {
    "Enabled": false
  },
  "Database": {
    "Provider": "Sqlite",
    "SqlitePath": "/var/lib/tradewithbeast/trade.sqlite",
    "TradeHistoryDatabasePath": "/var/lib/tradewithbeast/trade.sqlite"
  },
  "TradeHistory": {
    "DatabasePath": "/var/lib/tradewithbeast/trade.sqlite"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Infrastructure": {
    "PublicApiBaseUrl": "",
    "SignalREnableDetailedErrors": false,
    "PersistentDataRoot": "/var/lib/tradewithbeast",
    "RequirePersistentDataMount": true
  },
  "Security": {
    "JwtSigningKey": "",
    "DataEncryptionKey": "",
    "SessionLifetimeHours": 168,
    "CookieSecure": true,
    "CookieHttpOnly": true,
    "CookieSameSite": "Lax"
  },
  "ProductionSafety": {
    "Enabled": true,
    "DatabaseBackupEnabled": true,
    "DatabaseBackupIntervalHours": 24,
    "DatabaseBackupRetentionCount": 14,
    "DatabaseBackupDirectory": "/var/lib/tradewithbeast/backups",
    "DatabaseBackupVerifyAfterCreate": true
  },
  "SystemMonitoring": {
    "Enabled": true,
    "ComprehensiveCheckSeconds": 600
  },
  "IncidentNotification": {
    "NotificationsEnabled": false
  },
  "MStock": {
    "ApiKey": "",
    "Username": "",
    "Password": "",
    "AccessToken": "",
    "RestBaseUrl": "https://api.mstock.trade",
    "WsUrl": "wss://ws.mstock.trade"
  }
}