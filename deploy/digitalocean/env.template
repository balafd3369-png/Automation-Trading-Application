# Copy to /etc/tradewithbeast/environment (chmod 600). Never commit real values.

ASPNETCORE_ENVIRONMENT=Production
PORT=8080
ASPNETCORE_URLS=http://127.0.0.1:8080

# Auth (required — app will not start in Production without a strong admin password)
SystemIdentity__AdminPassword=REPLACE_WITH_STRONG_PASSWORD
SystemIdentity__RequireAuthentication=true
SystemIdentity__AllowAnonymousLocalUser=false
SystemIdentity__RegistrationMode=Open
SystemIdentity__AdminEmail=admin@yourdomain.com

# Live trading — keep false for restricted production
LiveTrading__Enabled=false

# Secrets (generate long random strings)
Security__JwtSigningKey=REPLACE_WITH_RANDOM_64_CHARS
Security__DataEncryptionKey=REPLACE_WITH_RANDOM_64_CHARS

# SQLite (single host — attach persistent volume at /var/lib/tradewithbeast)
Database__SqlitePath=/var/lib/tradewithbeast/trade.sqlite
TradeHistory__DatabasePath=/var/lib/tradewithbeast/trade.sqlite
ProductionSafety__DatabaseBackupDirectory=/var/lib/tradewithbeast/backups

# Public site URL (no trailing slash) — used for CORS and incident links
Infrastructure__PublicApiBaseUrl=https://yourdomain.com
Cors__AllowedOrigins__0=https://yourdomain.com

# Broker — set after m.Stock registration (optional for paper-only)
MStock__ApiKey=
MStock__Username=
MStock__Password=
MStock__TotpSecret=
MStock__RedirectUrl=
MStock__RestBaseUrl=https://api.mstock.trade
MStock__WsUrl=wss://ws.mstock.trade

# Optional alerts
IncidentNotification__NotificationsEnabled=false
IncidentNotification__EmailEnabled=false
IncidentNotification__SmtpHost=
IncidentNotification__SmtpUsername=
IncidentNotification__SmtpPassword=
IncidentNotification__SenderEmail=
IncidentNotification__PrimaryEmailRecipients__0=