# Example: edge-cache chart REST + proxy SignalR WebSocket to Trade with Beast backend.
# Place inside your server { } block (replace upstream host/port).

upstream twb_api {
    server 127.0.0.1:45211;
    keepalive 32;
}

# Chart candles — CDN / nginx cache (public; same for all users on this deployment)
location ~ ^/api/board/chart/[^/]+$ {
    proxy_pass http://twb_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

    proxy_cache twb_chart_cache;
    proxy_cache_key "$request_uri";
    proxy_cache_valid 200 45s;
    proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
    proxy_cache_background_update on;
    add_header X-Cache-Status $upstream_cache_status always;

    # Honor backend Cache-Control / ETag
    proxy_cache_revalidate on;
}

location /hubs/ {
    proxy_pass http://twb_api;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_read_timeout 3600s;
}

# proxy_cache_path for twb_chart_cache (http context):
# proxy_cache_path /var/cache/nginx/twb levels=1:2 keys_zone=twb_chart_cache:10m max_size=256m inactive=30m;
